# ============================================================
# terraform.tfvars.example
# Plantilla de ejemplo para las variables del proyecto.
# IMPORTANTE: Copiar este archivo como terraform.tfvars y
# completar los valores reales LOCALMENTE.
# NUNCA subir terraform.tfvars al repositorio (está en .gitignore).
# Las variables sensibles deben gestionarse en HCP Terraform.
# ============================================================

# ─── Generales ───────────────────────────────────────────────
resource_group_name = "rg-vm-sqlserver-prod"
location            = "centralus"
environment         = "production"
project_name        = "carlos-pruebas"
owner               = "cacorderob"

# ─── Red virtual ────────────────────────────────────────────
vnet_address_space    = ["10.0.0.0/16"]
subnet_address_prefix = "10.0.1.0/24"

# ─── Máquina Virtual ────────────────────────────────────────
vm_size      = "Standard_B2ats_v2"
os_disk_type = "StandardSSD_LRS"

# SENSIBLES — completar en HCP Terraform, NO aquí:
# admin_username = "<completar en HCP Terraform>"
# admin_password = "<completar en HCP Terraform>"

# ─── Azure SQL Server ────────────────────────────────────────
sql_database_sku   = "GP_S_Gen5_1"
sql_server_version = "12.0"

# SENSIBLES — completar en HCP Terraform, NO aquí:
# sql_admin_login    = "<completar en HCP Terraform>"
# sql_admin_password = "<completar en HCP Terraform>"
